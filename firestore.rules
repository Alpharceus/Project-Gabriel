rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One human, one auth user — pinned by uid, so self-service sign-up
    // (a console toggle, easy to leave open) grants a stranger nothing.
    // A uid is an opaque identifier, not a credential; safe to publish.
    function isOwner() {
      return request.auth != null
        && request.auth.uid == "DW4nJIAveqTRbLwDyy3pyoUCt863";
    }
    // Messages are append-only — history can't be rewritten from a client.
    match /messages/{id} {
      allow read, create: if isOwner();
      allow update, delete: if false;
    }
    match /devices/{token} {
      allow read, write: if isOwner();
    }
  }
}
