rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One human, one auth user; everything else stays locked.
    // Messages are append-only — history can't be rewritten from a client.
    match /messages/{id} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }
    match /devices/{token} {
      allow read, write: if request.auth != null;
    }
  }
}
